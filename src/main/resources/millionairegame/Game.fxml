               <Label text="11   $ 64,000" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <Label text="10   $ 32,000" textFill="#FFFFFF" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <Label text="9     $ 16,000" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <Label text="8     $ 8,000" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <Label text="7     $ 4,000" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
