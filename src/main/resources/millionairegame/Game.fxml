               <Label text="4     $ 500" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <Label text="3     $ 300" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <Label text="2     $ 200" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
               <Label text="1     $ 100" textFill="#F5A623" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
           </children>
       </VBox>
   </right>
</BorderPane>
