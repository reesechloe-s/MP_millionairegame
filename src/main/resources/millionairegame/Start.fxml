<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" spacing="25.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="millionairegame.StartController">
   <children>
      <ImageView fx:id="logoImage" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="titleLabel" text="Who Wants to Be a Millionaire?" />
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="15.0">
         <children>
            <Button fx:id="startButton" mnemonicParsing="false" onAction="#startGame" prefHeight="40.0" prefWidth="160.0" text="Start Game" />
            <Button fx:id="howToPlayButton" mnemonicParsing="false" onAction="#howToPlay" prefHeight="40.0" prefWidth="160.0" text="How to Play" />
         </children>
      </HBox>
   </children>
</VBox>
