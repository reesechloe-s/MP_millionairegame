<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="900.0" spacing="25.0"
      style="-fx-background-color: #0b132b;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="millionairegame.EndController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
        <Label fx:id="endTitleLabel" text="Game Over" textFill="#FFFFFF"
               style="-fx-font-size: 36px; -fx-font-weight: bold;" />
        <Label fx:id="finalPrizeLabel" text="You won: $0" textFill="#F5A623"
               style="-fx-font-size: 26px; -fx-font-weight: bold;" />
        <Button fx:id="playAgainButton" mnemonicParsing="false" onAction="#playAgain"
                prefHeight="50.0" prefWidth="200.0" text="Play Again"
                style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-cursor: hand;" />
    </children>
</VBox>